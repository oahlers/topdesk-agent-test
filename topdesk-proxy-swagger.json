{
  "swagger": "2.0",
  "info": {
    "title": "TOPdesk Live Search v50",
    "description": "Searches and retrieves live TOPdesk Knowledge Base articles through the Render proxy.",
    "version": "3.0.0"
  },
  "host": "topdesk-agent-test.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/search": {
      "get": {
        "summary": "Search TOPdesk Knowledge Base",
        "description": "Searches title, description, content, keywords and Knowledge Item numbers.",
        "operationId": "SearchTopdeskKnowledgeItems",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Search text"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 25
          }
        ],
        "responses": {
          "200": {
            "description": "Search results returned successfully.",
            "schema": {
              "$ref": "#/definitions/SearchResponse"
            }
          }
        }
      }
    },
    "/knowledge-items/{identifier}": {
      "get": {
        "summary": "Get single TOPdesk Knowledge Item",
        "description": "Retrieves one Knowledge Item by KI number or UUID.",
        "operationId": "GetTopdeskKnowledgeItem",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "KI number or UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Knowledge Item returned successfully.",
            "schema": {
              "$ref": "#/definitions/KnowledgeItem"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "KnowledgeItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "score": {
          "type": "integer"
        },
        "modificationDate": {
          "type": "string"
        }
      }
    },
    "SearchResponse": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "resultCount": {
          "type": "integer"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/KnowledgeItem"
          }
        }
      }
    }
  }
}