{
  "swagger": "2.0",
  "info": {
    "title": "TOPdesk Live Search v50",
    "description": "Searches and retrieves live TOPdesk Knowledge Base articles through the Render proxy.",
    "version": "3.0.0"
  },
  "host": "topdesk-agent-test.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/incidents/latest": {
  "get": {
    "tags": [
      "TOPdesk Incidents"
    ],
    "summary": "Get the latest accessible TOPdesk incident",
    "description": "Returns the most recently created TOPdesk incident that the integration account has permission to read. Use this operation when the user asks for the latest, newest or most recently registered case, ticket or incident.",
    "operationId": "GetLatestTopdeskIncident",
    "responses": {
      "200": {
        "description": "Latest accessible incident returned successfully.",
        "schema": {
          "$ref": "#/definitions/Incident"
        }
      },
      "404": {
        "description": "No accessible incidents were found."
      },
      "500": {
        "description": "Proxy configuration error."
      },
      "502": {
        "description": "TOPdesk connection error."
      }
    }
  }
}
    "/search": {
      "get": {
        "summary": "Search TOPdesk Knowledge Base",
        "description": "Searches title, description, content, keywords and Knowledge Item numbers.",
        "operationId": "SearchTopdeskKnowledgeItems",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Search text"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 25
          }
        ],
        "responses": {
          "200": {
            "description": "Search results returned successfully.",
            "schema": {
              "$ref": "#/definitions/SearchResponse"
            }
          }
        }
      }
    },
    "/knowledge-items/{identifier}": {
      "get": {
        "summary": "Get single TOPdesk Knowledge Item",
        "description": "Retrieves one Knowledge Item by KI number or UUID.",
        "operationId": "GetTopdeskKnowledgeItem",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "KI number or UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "Knowledge Item returned successfully.",
            "schema": {
              "$ref": "#/definitions/KnowledgeItem"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Incident": {
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "number": {
      "type": "string"
    },
    "briefDescription": {
      "type": "string"
    },
    "request": {
      "type": "string"
    },
    "creationDate": {
      "type": "string",
      "format": "date-time"
    },
    "modificationDate": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "object"
    },
    "priority": {
      "type": "object"
    },
    "caller": {
      "type": "object"
    },
    "operator": {
      "type": "object"
    },
    "operatorGroup": {
      "type": "object"
    }
  }
}
    "KnowledgeItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "score": {
          "type": "integer"
        },
        "modificationDate": {
          "type": "string"
        }
      }
    },
    "SearchResponse": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        },
        "resultCount": {
          "type": "integer"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/KnowledgeItem"
          }
        }
      }
    }
  }
}